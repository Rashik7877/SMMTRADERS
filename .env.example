# --- SuperAdmin sign-in (REQUIRED before first login) ---
# Generate ADMIN_PASSWORD_HASH with:  python scripts/hash_password.py
ADMIN_USERNAME=SMMTRADERS
ADMIN_PASSWORD_HASH=
# Any long random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Database (REQUIRED on Vercel; optional locally) ---
# Create with:  turso db create --tursodb smm-traders
# Get URLs with:  turso db show smm-traders  /  turso db tokens create smm-traders
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional ---
# Comma separated list of extra browser origins allowed to call the API.
# Leave empty when the UI and API share one deployment (the default).
CORS_ALLOW_ORIGINS=
# Force Secure cookies even outside Vercel (HTTPS deployments only).
COOKIE_SECURE=
